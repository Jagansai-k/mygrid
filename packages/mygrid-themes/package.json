{
  "name": "@inno-grid/mygrid-themes",
  "version": "0.0.0",
  "description": "Default, light, and dark theme foundations for MyGrid.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/theme.css",
    "./dist/light.css",
    "./dist/dark.css",
    "./dist/density.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/theme.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./light.css": "./dist/light.css",
    "./dark.css": "./dist/dark.css",
    "./density.css": "./dist/density.css"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "node ../../scripts/assert-release-ready.mjs",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jagansai-k/mygrid.git",
    "directory": "packages/mygrid-themes"
  }
}
