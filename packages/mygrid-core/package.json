{
  "name": "@inno-grid/mygrid-core",
  "version": "0.0.0",
  "description": "Framework-independent foundation for the MyGrid data grid.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
