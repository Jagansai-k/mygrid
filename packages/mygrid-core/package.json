{
  "name": "@inno-grid/mygrid-core",
  "version": "0.1.0",
  "description": "Framework-independent foundation for the MyGrid data grid.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "bench:sort": "vitest run --config vitest.bench.config.ts src/sort/sort.bench.ts",
    "bench:filter": "vitest run --config vitest.bench.config.ts src/filter/filter.bench.ts",
    "bench:page": "vitest run --config vitest.bench.config.ts src/pagination/page.bench.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "node ../../scripts/assert-release-ready.mjs",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jagansai-k/mygrid.git",
    "directory": "packages/mygrid-core"
  }
}
